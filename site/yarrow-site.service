[Unit]
Description=Yarrow project site (static)
After=network.target

[Service]
User=athena
Group=athena
WorkingDirectory=/opt/yarrow-site
ExecStart=/opt/athena/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8779 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true

[Install]
WantedBy=multi-user.target
